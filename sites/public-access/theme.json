{
  "name": "Public Access",
  "description": "80s public-access TV: VHS scanlines, neon pink and cyan, a channel-guide for dates. A ComicTable template.",
  "settings": [
    { "key": "accent", "label": "Neon color", "help": "The glow, the frame and the ticket buttons.", "type": "color", "default": "#FF3EA5" },
    { "key": "photo_shape", "label": "Your photo", "type": "select", "options": [["square", "This template's shape"], ["coaster", "Round, like your Coaster"]], "default": "square" },
    { "type": "heading", "label": "Words on the screen", "help": "Retype any of these, or clear one to take it off the page. {name} fills in your name." },
    { "key": "channel", "label": "Channel number", "type": "text", "default": "CH 03" },
    { "key": "osd", "label": "Top-right display", "type": "text", "default": "▶ PLAY" },
    { "key": "rec", "label": "On your photo", "type": "text", "default": "REC ●" },
    { "key": "shows_title", "label": "Shows heading", "type": "text", "default": "TV GUIDE · LIVE SHOWS" },
    { "key": "watch_title", "label": "Video heading", "type": "text", "default": "▶▶ NOW PLAYING" },
    { "key": "podcast_label", "label": "Above the podcast name", "type": "text", "default": "PODCAST" },
    { "key": "join_title", "label": "Sign-up heading", "type": "text", "default": "CALL IN NOW!" },
    { "key": "join_line", "label": "Sign-up line", "type": "text", "default": "Get on the list. Hear first when {name} plays near you." },
    { "key": "join_button", "label": "Sign-up button", "type": "text", "default": "SIGN ME UP ▶" },
    { "key": "footer", "label": "Bottom line", "type": "text", "default": "BE KIND, REWIND" }
  ]
}
