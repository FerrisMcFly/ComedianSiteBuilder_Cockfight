{
  "name": "Comic Book",
  "description": "A comic book issue: halftone panels, a speech bubble, caption boxes and TIX! bursts. A ComicTable template.",
  "settings": [
    { "key": "accent", "label": "Cover color", "help": "The cover panel and the podcast art.", "type": "color", "default": "#2F6BFF" },
    { "key": "photo_shape", "label": "Your photo", "type": "select", "options": [["square", "This template's shape"], ["coaster", "Round, like your Coaster"]], "default": "square" },
    { "type": "heading", "label": "Words on the page", "help": "Retype any of these, or clear one to take it off the page. {name} fills in your name, {next_city} your next show's city." },
    { "key": "issue", "label": "Top left of the cover", "type": "text", "default": "ISSUE #1" },
    { "key": "cover_right", "label": "Top right of the cover", "type": "text", "default": "{next_city}" },
    { "key": "bubble", "label": "Speech bubble", "type": "text", "default": "Stand-up comedy!" },
    { "key": "shows_title", "label": "Shows caption", "type": "text", "default": "NEXT TIME, LIVE ON STAGE…" },
    { "key": "watch_title", "label": "Video caption", "type": "text", "default": "MEANWHILE, ON YOUTUBE…" },
    { "key": "podcast_line", "label": "Under the podcast name", "type": "text", "default": "The podcast." },
    { "key": "join_title", "label": "Sign-up heading", "type": "text", "default": "JOIN THE FAN CLUB!" },
    { "key": "join_line", "label": "Sign-up line", "type": "text", "default": "Be first to know when {name} hits your town." },
    { "key": "join_button", "label": "Sign-up button", "type": "text", "default": "SIGN ME UP!" },
    { "key": "footer", "label": "Bottom line", "type": "text", "default": "TO BE CONTINUED…" }
  ]
}
