{
  "name": "90s Internet",
  "description": "A homemade 90s web page: a starfield, a gray window, a tables-and-borders show list and a guestbook. A ComicTable template.",
  "settings": [
    { "key": "accent", "label": "Headline color", "help": "The big welcome line.", "type": "color", "default": "#CC0066" },
    { "key": "photo_shape", "label": "Your photo", "type": "select", "options": [["square", "This template's shape"], ["coaster", "Round, like your Coaster"]], "default": "square" },
    { "type": "heading", "label": "Words on the page", "help": "Retype any of these, or clear one to take it off the page. {name} fills in your name." },
    { "key": "window_title", "label": "Window title bar", "type": "text", "default": "{name}'s Home Page" },
    { "key": "welcome", "label": "Welcome line", "type": "text", "default": "Welcome to {name}'s Home Page!!!" },
    { "key": "construction", "label": "Construction sign", "type": "text", "default": "UNDER CONSTRUCTION" },
    { "key": "shows_title", "label": "Shows heading", "type": "text", "default": "UPCOMING SHOWS" },
    { "key": "video_title", "label": "Video heading", "type": "text", "default": "MY VIDEO (takes a while on dial-up)" },
    { "key": "podcast_intro", "label": "Before the podcast name", "type": "text", "default": "My podcast" },
    { "key": "links_title", "label": "Before your links", "type": "text", "default": "Cool links:" },
    { "key": "join_title", "label": "Sign-up heading", "type": "text", "default": "Sign my Guestbook!" },
    { "key": "join_line", "label": "Sign-up line", "type": "text", "default": "Leave your email and ZIP and I'll tell you when I play near you." },
    { "key": "join_button", "label": "Sign-up button", "type": "text", "default": "Submit" },
    { "key": "footer", "label": "Bottom line", "type": "text", "default": "best viewed at 800×600" }
  ]
}
