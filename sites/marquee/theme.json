{
  "name": "Comedy Club Marquee",
  "description": "The classic club night: a light-bulb marquee, red velvet and a letterboard of dates. A ComicTable template.",
  "settings": [
    { "key": "accent", "label": "Accent color", "help": "The ticket buttons.", "type": "color", "default": "#FFD86B" },
    { "key": "photo_shape", "label": "Your photo", "type": "select", "options": [["square", "This template's shape"], ["coaster", "Round, like your Coaster"]], "default": "square" },
    { "type": "heading", "label": "Words on the page", "help": "Retype any of these, or clear one to take it off the page. {name} fills in your name." },
    { "key": "now_appearing", "label": "Above your name on the marquee", "type": "text", "default": "NOW APPEARING" },
    { "key": "shows_title", "label": "Letterboard heading", "type": "text", "default": "COMING UP" },
    { "key": "watch_title", "label": "Video heading", "type": "text", "default": "Tonight's Set" },
    { "key": "podcast_label", "label": "Above the podcast name", "type": "text", "default": "THE PODCAST" },
    { "key": "ticket_top", "label": "Top of the sign-up ticket", "type": "text", "default": "ADMIT ONE" },
    { "key": "ticket_number", "label": "Ticket number", "type": "text", "default": "Nº 0001" },
    { "key": "join_title", "label": "Sign-up heading", "type": "text", "default": "Save me a seat" },
    { "key": "join_line", "label": "Sign-up line", "type": "text", "default": "Hear first when {name} plays near you." },
    { "key": "join_button", "label": "Sign-up button", "type": "text", "default": "GET ON THE LIST" }
  ]
}
