{
  "name": "2000s Internet",
  "description": "A mid-2000s profile page: mood, online status, a profile song and your top shows. A ComicTable template.",
  "settings": [
    { "key": "accent", "label": "Accent color", "help": "The Top Shows and sign-up headers.", "type": "color", "default": "#F26522" },
    { "key": "photo_shape", "label": "Your photo", "type": "select", "options": [["square", "This template's shape"], ["coaster", "Round, like your Coaster"]], "default": "square" },
    { "type": "heading", "label": "Words on the page", "help": "Retype any of these, or clear one to take it off the page. {name} fills in your name." },
    { "key": "mood", "label": "Mood", "type": "text", "default": "ready to perform" },
    { "key": "online", "label": "Online status", "type": "text", "default": "Online Now!" },
    { "key": "song_label", "label": "Before the podcast name in the player", "type": "text", "default": "Profile song:" },
    { "key": "contact_title", "label": "Links box heading", "type": "text", "default": "Contacting {name}" },
    { "key": "contact_join", "label": "Sign-up link in the links box", "type": "text", "default": "Join my list" },
    { "key": "top_title", "label": "Shows heading", "type": "text", "default": "{name}'s Top Shows" },
    { "key": "about_title", "label": "Bio heading", "type": "text", "default": "About me:" },
    { "key": "videos_title", "label": "Video heading", "type": "text", "default": "Videos" },
    { "key": "join_title", "label": "Sign-up heading", "type": "text", "default": "Add {name} to your shows list" },
    { "key": "join_line", "label": "Sign-up line", "type": "text", "default": "Get an email when {name} plays near you." },
    { "key": "join_button", "label": "Sign-up button", "type": "text", "default": "Add to List" }
  ]
}
